# 复制到服务器 /opt/juejin/.env，chmod 600，严禁提交真实值
# deploy.sh 会自动改写为本地构建的镜像 tag
APP_IMAGE=juejin-backend:local-placeholder

MYSQL_URL=jdbc:mysql://mysql:3306/juejin?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-with-random-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=replace-with-at-least-32-bytes-random-string
SMS_PEPPER=replace-with-random-string
# dev 暂无真实短信平台：保持 mock=true，验证码只写日志；
# 上线真实短信平台后改为 false，并设置 SMS_EXPOSE_CODE=false
SMS_MOCK=true
SMS_EXPOSE_CODE=false
